#pragma kernel CSMain

struct Triangle
{
    float3 v0;
    float3 v1;
    float3 v2;
};

struct AABB
{
    float3 min;
    float3 max;
};

struct TriangleRange
{
    int startIndex;
    int count;
};

StructuredBuffer<float3> PositionBuffer;
RWStructuredBuffer<float>  MemoryBuffer;
RWStructuredBuffer<int>    VisibilityBuffer;
RWStructuredBuffer<float3> FinalPositionBuffer;

StructuredBuffer<Triangle> TriangleBuffer;
StructuredBuffer<AABB> AABBBuffer;
StructuredBuffer<TriangleRange> TriangleRangeBuffer;
int TotalAABBs;

uint    Count;
float   DeltaTime;
float   LearnRate;
float   ForgetRate;
float   Amplitude;
float   GlobalTime;
float4x4 CameraVP;
float4x4 LocalToWorld;
float2  ScreenSize;
float3  CameraPosition;
float   CullRadiusSqr;

float3 hash33(float3 p)
{
    p = frac(p * 0.1031);
    p += dot(p, p.yzx + 33.33);
    return frac((p.xxy + p.yzz) * p.zyx);
}

bool RayIntersectsAABB(float3 rayOrigin, float3 rayDir, AABB box)
{
    float3 invDir = 1.0 / rayDir;
    float3 t1 = (box.min - rayOrigin) * invDir;
    float3 t2 = (box.max - rayOrigin) * invDir;

    float3 tmin = min(t1, t2);
    float3 tmax = max(t1, t2);

    float tNear = max(max(tmin.x, tmin.y), tmin.z);
    float tFar  = min(min(tmax.x, tmax.y), tmax.z);

    return tNear <= tFar && tFar >= 0.0;
}

bool RayTriangleIntersect(float3 rayOrigin, float3 rayDir, Triangle tri, out float hitDist)
{
    float3 v0v1 = tri.v1 - tri.v0;
    float3 v0v2 = tri.v2 - tri.v0;
    float3 pvec = cross(rayDir, v0v2);
    float det = dot(v0v1, pvec);

    if (abs(det) < 1e-8)
    {
        hitDist = 0;
        return false;
    }

    float invDet = 1.0 / det;
    float3 tvec = rayOrigin - tri.v0;
    float u = dot(tvec, pvec) * invDet;
    if (u < 0 || u > 1)
    {
        hitDist = 0;
        return false;
    }

    float3 qvec = cross(tvec, v0v1);
    float v = dot(rayDir, qvec) * invDet;
    if (v < 0 || u + v > 1)
    {
        hitDist = 0;
        return false;
    }

    hitDist = dot(v0v2, qvec) * invDet;
    return hitDist > 0;
}

[numthreads(64,1,1)]
void CSMain (uint3 id : SV_DispatchThreadID)
{
    uint i = id.x;
    if (i >= Count) return;

    float3 origPos = PositionBuffer[i];
    float4 worldPos4 = mul(LocalToWorld, float4(origPos, 1));
    float3 worldPos = worldPos4.xyz;

    float distToPoint = distance(worldPos, CameraPosition);
    if (distToPoint * distToPoint > CullRadiusSqr)
    {
        MemoryBuffer[i] = 0;
        FinalPositionBuffer[i] = worldPos;
        VisibilityBuffer[i] = 0;
        return;
    }

    float4 clipPos = mul(CameraVP, worldPos4);
    float3 ndc = clipPos.xyz / clipPos.w;

    bool isInFrustum =
        ndc.x >= -1 && ndc.x <= 1 &&
        ndc.y >= -1 && ndc.y <= 1 &&
        ndc.z >= 0  && ndc.z <= 1;

    if (!isInFrustum)
    {
        VisibilityBuffer[i] = 0;
    }
    else
    {
        float3 rayDir = normalize(worldPos - CameraPosition);
        bool occluded = false;

        for (int aabbIndex = 0; aabbIndex < TotalAABBs; aabbIndex++)
        {
            AABB box = AABBBuffer[aabbIndex];
            if (!RayIntersectsAABB(CameraPosition, rayDir, box))
                continue;

            TriangleRange range = TriangleRangeBuffer[aabbIndex];
            for (int j = 0; j < range.count; j++)
            {
                float hitDist;
                Triangle tri = TriangleBuffer[range.startIndex + j];
                if (RayTriangleIntersect(CameraPosition, rayDir, tri, hitDist))
                {
                    if (hitDist < distToPoint)
                    {
                        occluded = true;
                        break;
                    }
                }
            }

            if (occluded) break;
        }

        VisibilityBuffer[i] = occluded ? 0 : 1;
    }

    // Memory logic
    float mem = MemoryBuffer[i];
    float distance01 = distToPoint / sqrt(CullRadiusSqr);
    float invDistance = 1.0 - distance01;

    float modLearnRate  = LearnRate  * invDistance * (1.0 - mem);
    float modForgetRate = ForgetRate * distance01  * mem;

    if (isInFrustum && VisibilityBuffer[i] == 1)
        mem += modLearnRate * DeltaTime;
    else
        mem -= modForgetRate * DeltaTime;

    mem = saturate(mem);
    MemoryBuffer[i] = mem;

    if (mem < 0.5)
    {
        float fade = (0.5 - mem) * 2.0;
        fade *= fade;

        float3 noise = hash33(origPos);
        float3 oscillation = sin(noise * 10.0 + GlobalTime * 0.5);
        float3 shift = oscillation * fade * Amplitude;

        FinalPositionBuffer[i] = worldPos + shift;
    }
    else
    {
        FinalPositionBuffer[i] = worldPos;
    }
}
